# =========================================================================
# Application Environment Variables Example
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit real secrets or credentials to version control!
# =========================================================================

# --- Spring Boot Server ---
# Port 8080 is often used by services like Jenkins; default set to 8082
SERVER_PORT=8082

# --- MySQL Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=energy_trading
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
# Optional full DB_URL override:
# DB_URL=jdbc:mysql://localhost:3306/energy_trading?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- Local EVM Blockchain (Hardhat) ---
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Hardhat Account #0 default local test key (FOR LOCAL DEV/DEMO ONLY)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
