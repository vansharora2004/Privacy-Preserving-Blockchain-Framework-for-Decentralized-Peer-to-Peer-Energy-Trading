# =========================================================================
# Application Environment Variables Example
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit real secrets or credentials to version control!
# =========================================================================

# --- Spring Boot Server ---
# Port 8080 is often used by services like Jenkins; default set to 8082
SERVER_PORT=8082

# --- MySQL Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=energy_trading
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
# Optional full DB_URL override:
# DB_URL=jdbc:mysql://localhost:3306/energy_trading?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- Schema management ---
# database/schema.sql is authoritative; Hibernate only validates against it.
# Use JPA_DDL_AUTO=update only for throwaway local databases.
JPA_DDL_AUTO=validate

# --- Demo seed data (only inserted when the users table is empty) ---
SEED_DEMO_DATA=true
# Leave blank to seed demo accounts with random (unusable) passwords.
DEMO_HOUSEHOLD_PASSWORD=
DEMO_ADMIN_PASSWORD=

# --- CORS (comma-separated browser origins allowed to call the API) ---
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

# --- Privacy (REQUIRED from Batch 2) ---
# Secret HMAC key for household pseudonyms, at least 32 characters. The backend refuses to
# start without it. Generate one locally, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
# Changing it changes every pseudonym (older anomaly-log references no longer match).
PRIVACY_PSEUDONYM_KEY=replace-with-a-random-secret-of-at-least-32-characters

# --- Smart-meter validation thresholds (optional; defaults shown) ---
METER_MAX_GENERATED_KWH=25.000
METER_MAX_CONSUMED_KWH=25.000
METER_MAX_FUTURE_SKEW=5m
METER_MAX_READING_AGE=7d
METER_MAX_SEQUENCE_GAP=0
METER_CONTINUITY_WINDOW=24h

# --- Anomaly rule thresholds (optional; defaults shown) ---
ANOMALY_MAX_PRICE_PER_KWH=15.00
ANOMALY_MAX_READING_JUMP_KWH=20.00
ANOMALY_MAX_RELATIVE_CHANGE=3.0
ANOMALY_RELATIVE_MIN_BASELINE_KWH=1.0
ANOMALY_ACTIVITY_WINDOW=1h
ANOMALY_MAX_READINGS_PER_WINDOW=12

# --- Local EVM Blockchain (Hardhat) ---
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Hardhat Account #0 default local test key. This key is publicly known:
# use it ONLY on the local Hardhat network, never on a real network.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
