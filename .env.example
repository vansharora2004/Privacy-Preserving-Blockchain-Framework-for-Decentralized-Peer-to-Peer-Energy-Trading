# =========================================================================
# Application Environment Variables Example
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit real secrets or credentials to version control!
# =========================================================================

# --- Spring Boot Server ---
# Port 8080 is often used by services like Jenkins; default set to 8082
SERVER_PORT=8082

# --- MySQL Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=energy_trading
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
# Optional full DB_URL override:
# DB_URL=jdbc:mysql://localhost:3306/energy_trading?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- Schema management ---
# database/schema.sql is authoritative; Hibernate only validates against it.
# Use JPA_DDL_AUTO=update only for throwaway local databases.
JPA_DDL_AUTO=validate

# --- Demo seed data (only inserted when the users table is empty) ---
SEED_DEMO_DATA=true
# Leave blank to seed demo accounts with random (unusable) passwords.
DEMO_HOUSEHOLD_PASSWORD=
DEMO_ADMIN_PASSWORD=

# --- CORS (comma-separated browser origins allowed to call the API) ---
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

# --- Privacy (REQUIRED from Batch 2) ---
# Secret HMAC key for household pseudonyms, at least 32 characters. The backend refuses to
# start without it. Generate one locally, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
# Changing it changes every pseudonym (older anomaly-log references no longer match). Trades keep
# their stored on-chain party references, so they stay verifiable (docs/privacy-and-security.md, 3).
PRIVACY_PSEUDONYM_KEY=replace-with-a-random-secret-of-at-least-32-characters

# --- Smart-meter validation thresholds (optional; defaults shown) ---
METER_MAX_GENERATED_KWH=25.000
METER_MAX_CONSUMED_KWH=25.000
METER_MAX_FUTURE_SKEW=5m
METER_MAX_READING_AGE=7d
METER_MAX_SEQUENCE_GAP=0
METER_CONTINUITY_WINDOW=24h

# --- Anomaly rule thresholds (optional; defaults shown) ---
ANOMALY_MAX_PRICE_PER_KWH=15.00
ANOMALY_MAX_READING_JUMP_KWH=20.00
ANOMALY_MAX_RELATIVE_CHANGE=3.0
ANOMALY_RELATIVE_MIN_BASELINE_KWH=1.0
ANOMALY_ACTIVITY_WINDOW=1h
ANOMALY_MAX_READINGS_PER_WINDOW=12

# --- Local EVM Blockchain (Hardhat, Batch 3) ---
# Off by default: trades are then reserved but never CONFIRMED (reservations expire).
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# Printed by `npm run deploy:local` and stored in blockchain/deployments/localhost.json
CONTRACT_ADDRESS=replace-with-deployed-address
# deploymentId from the same file (bytes32 hex). Required when enabled: it detects a chain reset or
# redeployment at the same address. Change it only after reviewing the new deployment (README).
BLOCKCHAIN_DEPLOYMENT_ID=
# Private key of the authorized recorder account (RECORDER_ADDRESS at deployment).
# Use a Hardhat dev account only; never a real wallet. Never commit a value here.
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
# Optional tuning (defaults shown)
BLOCKCHAIN_RECEIPT_TIMEOUT=15s
BLOCKCHAIN_MAX_SUBMISSION_ATTEMPTS=3
BLOCKCHAIN_UNKNOWN_TX_GRACE=60s
# Only the backend instance holding the signer lease signs; a killed instance blocks signing for at most one TTL.
BLOCKCHAIN_SIGNER_LEASE_TTL=30s
# How long a purchase waits for the submission slot before it is left PENDING for the scheduler.
BLOCKCHAIN_SUBMIT_LOCK_WAIT=2s
BLOCKCHAIN_ANCHOR_AUDIT_BATCH_SIZE=200

# --- Marketplace (Batch 3, optional; defaults shown) ---
MARKET_DEFAULT_OFFER_LIFETIME=60m
MARKET_MAX_OFFER_LIFETIME=24h
MARKET_MAX_SOURCE_READING_AGE=24h
MARKET_RESERVATION_TIMEOUT=15m
MARKET_FLAGGED_REVIEW_TIMEOUT=24h
MARKET_SCHEDULER_ENABLED=true
MARKET_MAINTENANCE_INTERVAL_MS=30000
# Re-verifies CONFIRMED trades against the current deployment (raises ANCHOR_MISSING / ANCHOR_INVALID alerts).
MARKET_ANCHOR_AUDIT_INTERVAL_MS=300000

# Hardhat Account #0 default local test key. This key is publicly known:
# use it ONLY on the local Hardhat network, never on a real network.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
